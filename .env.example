# ==============================================================================
# AuthGuard Service - Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with your actual credentials.
# NOTE: .env is in .gitignore and will NEVER be pushed to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEON / SUPABASE POSTGRESQL (Required)
# ------------------------------------------------------------------------------
# In Neon Console: Project -> Connection Details -> Connection String (select "Pooled connection" / pgbouncer)
# Format: jdbc:postgresql://<neon-host>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
DB_URL=jdbc:postgresql://ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=your_neon_password_here

# ------------------------------------------------------------------------------
# 2. REDIS CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Option A: Local Redis (Recommended for 1GB VPS - <0.5ms latency)
# If running Redis on the same VPS / machine:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# Option B: Upstash Redis (Serverless Remote)
# If using Upstash (upstash.com):
# REDIS_HOST=your-db.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your_upstash_token
# REDIS_SSL=true

# ------------------------------------------------------------------------------
# 3. JWT SECURITY CONFIGURATION (Required for Production)
# ------------------------------------------------------------------------------
# A secure 256-bit (or 512-bit) secret key for HMAC-SHA256 signing (at least 64 characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
